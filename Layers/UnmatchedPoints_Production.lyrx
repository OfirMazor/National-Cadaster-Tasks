            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var cpb_guid = $feature.CPBUniqueID;\nvar cpb_layer = FeatureSetByName($map, \"גבולות תהליכי קדסטר\", [\"ProcessName\", \"Status\", \"ProcessType\"], false);\nvar data = First(Filter(cpb_layer, \"GlobalID = @cpb_guid\"));\n\nvar dict = {type: 'fields', title: '', description: '',\n            fieldInfos: [{fieldName: \"שם המפה\", label: \"שם המפה\", visible: true},\n                         {fieldName: \"סוג תהליך\", label: \"סוג תהליך\", visible: true},\n                         {fieldName: \"סטטוס\", label: \"סטטוס\", visible: true},\n                         {fieldName: \"מזהה תהליך\", label: \"מזהה תהליך\", visible: true}],\n\n             attributes: {\"שם המפה\": data.ProcessName,\n                          \"סוג תהליך\": DomainName(cpb_layer, 'ProcessType', data.ProcessType),\n                          \"סטטוס\": DomainName(cpb_layer, 'Status', data.Status),\n                          \"מזהה תהליך\": StandardizeGuid(cpb_guid,'digits-hyphen')}};\n \nreturn dict;",
              "returnType" : "Default"
            }
          }
        ],
